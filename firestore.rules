rules_version = '2';

// The gateway uses the Admin SDK, which bypasses these rules entirely. They
// exist for any future direct-from-client access, and they deny by default:
// a user can only ever reach their own subtree.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
