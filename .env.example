# Copy to .env.local and source it, or set these in your shell.
# Nothing here is a secret: credentials come from Application Default
# Credentials (gcloud auth application-default login) or the Cloud Run
# service account. There are no key files in this repo, ever.

# --- local development (emulators) ---
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GOOGLE_CLOUD_PROJECT=alltheway-local
# Serves a fixed dev identity while the web client is still on local auth.
# Refuses to engage when NODE_ENV=production.
ALLOW_ANONYMOUS=true
DEV_USER_ID=dev-user

# --- Vertex (always real; there is no emulator) ---
# `global` is where current Gemini Flash models live. Independent of the
# Cloud Run region, which stays europe-west1.
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.7-flash

# --- research cell ---
# Internal-only A2A service. The orchestrator resolves its card from this URL.
RESEARCH_CELL_URL=http://localhost:8093
# How long the orchestrator waits for a finding. A cell that does not answer is
# not fatal: the turn plans without it and says so in the trace.
RESEARCH_TIMEOUT_S=30
# Fault injection for verifying degradation against a running service. Fake
# provider only, so it cannot engage in a deployed cell. Unset by default.
# FAKE_RESEARCH_FAIL=counterpoint
# FAKE_RESEARCH_HANG_S_COUNTERPOINT=30

# --- connectors and screening ---
# The Agent Gateway: the only path to a connector.
CONNECTOR_GATEWAY_URL=http://localhost:8094
# Model Armor screens untrusted external content. Unset falls back to the local
# heuristic screener, which is a development posture, not a production one.
# Screening FAILS CLOSED either way: unreachable means blocked, never allowed.
# MODEL_ARMOR_TEMPLATE=projects/<project>/locations/<region>/templates/<id>
# Connector credentials come from Secret Manager, never from environment
# variables. Locally they are read from files in this directory instead, so the
# dev path has the same shape and the same failure modes.
DEV_SECRETS_DIR=.secrets
# USE_SECRET_MANAGER=true

# --- voice ---
# Vertex Live native audio (`gemini-live-2.5-flash-native-audio`). Auto-detects
# language; language_code cannot be set. Pinned, never "latest". The browser
# never holds this credential — the gateway relays PCM. Locally a fake Live
# backend answers so AudioWorklet can be tested with no GCP project.
# See docs/decisions/0006.
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio

# --- streaming ---
# Slows the fake provider so a plan panel filling in is observable locally.
# Off (0) by default. It delays a real answer; it never invents progress, and
# FakeProvider is not used in a deployed service.
FAKE_STREAM_DELAY_MS=0

# --- deployed ---
# Unset the two EMULATOR_HOST vars and ALLOW_ANONYMOUS; set the real project:
# GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>

# The turn stream cannot go through the Firebase Hosting /api/** rewrite:
# Hosting imposes an unconfigurable 60-second timeout on rewrites that severs a
# long-lived stream. See docs/decisions/0001. So the stream is served from the
# gateway's own hostname, which makes it cross-origin, which needs both of:
#
#   gateway:  WEB_ORIGINS=https://alltheway.rinegansolutions.com
#   web:      VITE_STREAM_ORIGIN=https://<gateway-hostname>
#
# Both are empty in development, where Vite proxies /api (including the voice
# WebSocket) and the request is same-origin. The gateway's Cloud Run request
# timeout is 3600s so a voice socket is not hung up at 300s.
