{
  "manifest_version": 3,
  "name": "AllTheWay meeting notes",
  "version": "0.3.0",
  "description": "Takes notes in the meeting you are already in. On Meet it can read names Meet already shows in captions. It cannot speak. Nothing joins unless you send AllTheWay notes.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "sidePanel",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "https://alltheway.rinegansolutions.com/*",
    "https://alltheway-prod.web.app/*",
    "https://meet.google.com/*",
    "https://zoom.us/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*",
    "https://teams.live.com/*"
  ],
  "optional_host_permissions": [
    "https://*.run.app/*",
    "https://*.a.run.app/*",
    "wss://*.run.app/*",
    "wss://*.a.run.app/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "ws://localhost:*/*",
    "ws://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AllTheWay meeting notes",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://alltheway.rinegansolutions.com/*",
        "https://alltheway-prod.web.app/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "meet-captions.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
