# Root ignore rules for the whole workspace.
# web/ and infra/ keep their own for tool-specific noise; this covers anything
# that can appear in more than one place.

# ---- dependencies & build output ----
node_modules/
dist/
build/
*.tsbuildinfo

# ---- secrets ----
# .env.example IS committed: it documents the variables and contains no secrets.
# Credentials come from Application Default Credentials or the Cloud Run service
# account — there should never be a key file in this repo to ignore.
.env
.env.local
.env.*.local
*.pem
*-service-account*.json
!.env.example

# ---- Firebase / emulators ----
# The emulators drop these in whatever directory they are started from.
*-debug.log
.firebase/
firebase-export-*/
.runtimeconfig.json

# ---- Terraform ----
# infra/.gitignore covers this properly; repeated here as a safety net, because
# a committed state file can leak resource ids and is painful to undo.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# ---- Python services ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# ---- test & verification artefacts ----
# Screenshots are regenerated by `npm run shots`; they are evidence, not source.
screenshots/
playwright-report/
test-results/

# ---- editors & OS ----
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local connector credentials. Never committed; Secret Manager in deployed envs.
.secrets/

# Emulator-only artifact bytes when ARTIFACTS_DIR is set.
.local-artifacts/

# Local service run logs. These are uvicorn/npm output from running the stack on
# a developer machine — they change on every run, and five of them were tracked
# before this rule existed.
**/boot.log
**/preview.log

# Generated at build time from the Firebase web app config.
web/.env.production
